<style>
  #panel-container {
    align-items: stretch;
    padding: 2;
    width: 50;
    display: flex;
    flex-direction: column;
    background-color: #0a0f1f;
    border-color: #46e0c0;
    border-width: 0.18;
    border-radius: 3;
  }

  .title {
    font-size: 4.2;
    font-weight: medium;
    color: #7ff5e6;
    text-align: center;
    margin-bottom: 0.4;
  }

  .subtitle {
    font-size: 1.6;
    color: #9aa4d4;
    text-align: center;
    margin-bottom: 1.6;
  }

  .section-label {
    font-size: 1.4;
    color: #6d7792;
    text-align: center;
    margin-top: 0.4;
    margin-bottom: 0.6;
  }

  .row {
    display: flex;
    flex-direction: row;
    gap: 0.6;
    margin-bottom: 1.4;
  }

  .diff-btn {
    flex-grow: 1;
    flex-basis: 0;
    padding-top: 0.9;
    padding-bottom: 0.9;
    background-color: #0c1428;
    color: #9aa4d4;
    border-color: #1f304d;
    border-width: 0.08;
    border-radius: 1.4;
    font-size: 1.6;
    font-weight: medium;
    text-align: center;
    cursor: pointer;
  }

  #btn-play {
    width: 100%;
    padding: 1.4;
    margin-bottom: 0.8;
    background-color: #3fe07a;
    color: #051a0c;
    border-color: #3fe07a;
    border-width: 0.1;
    border-radius: 1.6;
    font-size: 2.4;
    font-weight: medium;
    text-align: center;
    cursor: pointer;
  }

  #xr-button {
    width: 100%;
    padding: 1.2;
    background-color: #46e0c0;
    color: #051a0c;
    border-color: #7ff5e6;
    border-width: 0.08;
    border-radius: 1.4;
    font-size: 2;
    font-weight: medium;
    text-align: center;
    cursor: pointer;
  }
</style>
<div id="panel-container">
  <span class="title">SERPENT GRID XR</span>
  <span class="subtitle">Holographic Serpent Grid</span>
  <span class="section-label">DIFFICULTY</span>
  <div class="row">
    <button id="diff-easy" class="diff-btn">EASY</button>
    <button id="diff-normal" class="diff-btn">NORMAL</button>
    <button id="diff-hard" class="diff-btn">HARD</button>
  </div>
  <button id="btn-play">PLAY</button>
  <button id="xr-button">Enter XR</button>
</div>
